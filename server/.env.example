NODE_ENV=development

# HTTP server. HOST=0.0.0.0 lets the Android emulator (10.0.2.2) and LAN devices reach the API.
PORT=4000
HOST=0.0.0.0

# Matches the defaults in the root docker-compose.yml
DATABASE_URL=postgresql://trackfit:trackfit@localhost:5432/trackfit?schema=public

# Comma-separated list of allowed browser origins. Leave empty to allow all origins.
# http://localhost:5173 = Vite dev server, https://localhost = Capacitor Android WebView
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
