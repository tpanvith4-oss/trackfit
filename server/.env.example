NODE_ENV=development

# HTTP server. HOST=0.0.0.0 lets the Android emulator (10.0.2.2) and LAN devices reach the API.
PORT=4000
HOST=0.0.0.0

# Matches the defaults in the root docker-compose.yml
DATABASE_URL=postgresql://trackfit:trackfit@localhost:5432/trackfit?schema=public

# Secret used to sign login tokens. Required (32+ chars) when deployed; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Leave unset locally to use the built-in development secret.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Google Gemini key for the AI meal estimator (POST /api/food/ai-parse); get one at
# https://aistudio.google.com/apikey. Leave empty to run without AI estimates.
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash; keys created before its deprecation can still use gemini-2.5-flash.
# GEMINI_MODEL=gemini-3.8-flash

# NVIDIA NIM fallback for the same endpoint. Used when Gemini is unset or its call fails.
# Create a key at https://build.nvidia.com (it starts with nvapi-). Leave empty to use Gemini only.
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Comma-separated list of allowed browser origins. Leave empty to allow all origins.
# The TrackFit app's own WebView origins (https://localhost, capacitor://localhost) are always allowed.
CORS_ORIGINS=http://localhost:5173
