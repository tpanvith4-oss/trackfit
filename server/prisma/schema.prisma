generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  passwordHash    String        @map("password_hash")
  name            String
  baselineWeight  Float         @default(64.0) @map("baseline_weight")
  targetWeightMin Float         @default(58.0) @map("target_weight_min")
  targetWeightMax Float         @default(60.0) @map("target_weight_max")
  dailyCalories   Int           @default(1800) @map("daily_calories")
  dailyProtein    Int           @default(135) @map("daily_protein")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  foodEntries     FoodEntry[]
  weightEntries   WeightEntry[]
  sleepSchedule   SleepSchedule?
  activityEntries ActivityEntry[]

  @@map("users")
}

model FoodEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(120)
  calories  Int
  proteinG  Float?   @map("protein_g")
  carbsG    Float?   @map("carbs_g")
  fatG      Float?   @map("fat_g")
  mealType  MealType @default(SNACK) @map("meal_type")
  loggedAt  DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, loggedAt])
  @@map("food_entries")
}

model WeightEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float    @map("weight_kg")
  note      String?  @db.VarChar(280)
  loggedAt  DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, loggedAt])
  @@map("weight_entries")
}

model SleepSchedule {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetWakeTime       String   @default("06:30") @map("target_wake_time") @db.VarChar(5)
  targetSleepHours     Float    @default(7.5) @map("target_sleep_hours")
  latencyMinutes       Int      @default(15) @map("latency_minutes")
  enableCognitiveAlarm Boolean  @default(true) @map("enable_cognitive_alarm")
  alarmChallengeType   String   @default("math") @map("alarm_challenge_type") @db.VarChar(16)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sleep_schedules")
}

/// Synced rows hold one day's totals per source, keyed by `syncDay` (the device's calendar
/// date); `date` is noon UTC of that day. Manual rows are individual workouts with a null
/// `syncDay`, which Postgres treats as distinct, so they never collide in the unique key.
model ActivityEntry {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime  @default(now()) @db.Timestamptz(3)
  syncDay         DateTime? @map("sync_day") @db.Date
  steps           Int       @default(0)
  activeCalories  Int       @default(0) @map("active_calories")
  distanceKm      Float?    @default(0.0) @map("distance_km")
  exerciseType    String?   @map("exercise_type") @db.VarChar(60)
  durationMinutes Int?      @map("duration_minutes")
  source          String    @default("manual") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, source, syncDay])
  @@index([userId, date])
  @@map("activity_entries")
}
