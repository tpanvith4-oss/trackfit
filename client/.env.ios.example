# Copy to .env.ios. Loaded by `npm run build:ios` (vite --mode ios) and overrides .env for the IPA.
# Base URL of the TrackFit API (no trailing slash, without /api).

# Deployed API (HTTPS required — iOS App Transport Security blocks plain HTTP by default)
VITE_API_BASE_URL=https://your-trackfit-api.onrender.com

# Local Mac API from the iOS Simulator (host machine):
#VITE_API_BASE_URL=http://127.0.0.1:4000
