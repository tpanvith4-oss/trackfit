# Copy to .env.android. Loaded by `npm run build:android` (vite --mode android) and overrides .env for the APK.
# Base URL of the TrackFit API (no trailing slash, without /api).

# Deployed API (HTTPS, works on any device and network)
VITE_API_BASE_URL=https://your-trackfit-api.onrender.com

# Local API instead: 10.0.2.2 is the host machine as seen from the Android emulator;
# for a physical device use your computer's LAN IP, e.g. http://192.168.1.20:4000
#VITE_API_BASE_URL=http://10.0.2.2:4000
