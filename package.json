{
  "name": "trackfit",
  "version": "0.1.0",
  "private": true,
  "description": "TrackFit - personal food & weight tracker (React + Capacitor client, Express + PostgreSQL server)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build --workspace @trackfit/client && npm run start --workspace @trackfit/server",
    "dev:all": "concurrently --kill-others-on-fail --names server,client --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @trackfit/server",
    "dev:client": "npm run dev --workspace @trackfit/client",
    "start": "npm run start --workspace @trackfit/server",
    "build": "npm run build --workspace @trackfit/client",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate --workspace @trackfit/server",
    "db:deploy": "npm run db:deploy --workspace @trackfit/server",
    "db:studio": "npm run db:studio --workspace @trackfit/server",
    "android:add": "npm run android:add --workspace @trackfit/client",
    "android:sync": "npm run android:sync --workspace @trackfit/client",
    "android:open": "npm run android:open --workspace @trackfit/client",
    "ios:add": "npm run ios:add --workspace @trackfit/client",
    "ios:sync": "npm run ios:sync --workspace @trackfit/client",
    "ios:open": "npm run ios:open --workspace @trackfit/client"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  }
}
