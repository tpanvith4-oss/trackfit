{
  "name": "trackfit",
  "version": "0.1.0",
  "private": true,
  "description": "TrackFit - personal food & weight tracker (React + Capacitor client, Express + PostgreSQL server)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:deploy": "npm run db:deploy --workspace server",
    "db:studio": "npm run db:studio --workspace server",
    "android:add": "npm run android:add --workspace client",
    "android:sync": "npm run android:sync --workspace client",
    "android:open": "npm run android:open --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
